<Application x:Class="NetControl.Windows.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Margin" Value="4"/></Style>
    <Style TargetType="Button"><Setter Property="Margin" Value="5"/><Setter Property="Padding" Value="14,8"/><Setter Property="FontSize" Value="14"/></Style>
    <Style TargetType="TextBox"><Setter Property="Margin" Value="5"/><Setter Property="Padding" Value="8"/><Setter Property="FontSize" Value="14"/></Style>
  </Application.Resources>
</Application>
